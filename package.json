{
  "name": "jedibo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host --mode lan",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.pure.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.pure.json",
    "netsim": "esbuild scripts/netsim.ts --bundle --platform=node --format=esm --outfile=node_modules/.sim/netsim.mjs --log-level=warning && node node_modules/.sim/netsim.mjs",
    "sim": "esbuild scripts/sim.ts --bundle --platform=node --format=esm --outfile=node_modules/.sim/sim.mjs --log-level=warning && node node_modules/.sim/sim.mjs",
    "arena": "esbuild scripts/arena.ts --bundle --platform=node --format=esm --outfile=node_modules/.sim/arena.mjs --log-level=warning && node node_modules/.sim/arena.mjs",
    "aicheck": "esbuild scripts/aicheck.ts --bundle --platform=node --format=esm --outfile=node_modules/.sim/aicheck.mjs --log-level=warning && node node_modules/.sim/aicheck.mjs",
    "tune": "esbuild scripts/tune.ts --bundle --platform=node --format=esm --outfile=node_modules/.sim/tune.mjs --log-level=warning && node node_modules/.sim/tune.mjs",
    "clock": "esbuild scripts/clock.ts --bundle --platform=node --format=esm --outfile=node_modules/.sim/clock.mjs --log-level=warning && node node_modules/.sim/clock.mjs",
    "quality": "esbuild scripts/quality.ts --bundle --platform=node --format=esm --outfile=node_modules/.sim/quality.mjs --log-level=warning && node node_modules/.sim/quality.mjs",
    "test": "esbuild scripts/test.ts --bundle --platform=node --format=esm --outfile=node_modules/.sim/test.mjs --log-level=warning && node node_modules/.sim/test.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "1.2.0",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  },
  "dependencies": {
    "peerjs": "1.5.5"
  }
}
